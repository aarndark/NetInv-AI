# Виртуальное окружение Python
.venv/
venv/
env/

# Байт-код Python
__pycache__/
*.py[cod]
*$py.class

# База данных SQLite (рабочие данные, не версионируются)
data/data.db
data/data.db-*
data/*.sqlite
data/*.sqlite3

# Резервные копии БД
backups/

# Логи (каталог локального фолбэка и отдельные файлы логов)
*.log
logs/

# Временные файлы
*.tmp
*.swp
*~

# Файлы IDE / редакторов
.idea/
.vscode/
*.sublime-*

# Системные файлы ОС
.DS_Store
Thumbs.db

# Кэш онлайн-CVE (CIRCL) — не хранить в репозитории
data/cve_cache/
